{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "captainsolo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Prerendered pages exist as files; anything else gets the designed 404 page.
    "not_found_handling": "404-page",
    // Every request goes through the Worker so www.* can redirect to the bare domain.
    // shortcut: counts each asset against the free 100k requests/day (~5k page views); use a Cloudflare
    // Redirect Rule for www and set this back to ["/api/*"] if traffic ever gets near that.
    "run_worker_first": true
  },
  // Keep the workers.dev address on: a deploy without this silently disables it.
  "workers_dev": true,
  // Custom domains: Cloudflare creates and manages the DNS records for these hostnames.
  "routes": [
    { "pattern": "captainsolo.ca", "custom_domain": true },
    { "pattern": "www.captainsolo.ca", "custom_domain": true }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    // Must be a verified destination in Cloudflare → captainsolo.ca → Email Routing → Destination addresses.
    "CONTACT_TO": "solomonolufelo@outlook.com",
    "CONTACT_FROM": "contact@captainsolo.ca"
  },
  "observability": { "enabled": true }
}
