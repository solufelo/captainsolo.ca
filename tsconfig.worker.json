{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "emitDeclarationOnly": true,
    "outDir": ".tsbuild",
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["worker"]
}
